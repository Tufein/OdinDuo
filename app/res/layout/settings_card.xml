<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.OdinDuo.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="?attr/colorSurfaceContainerLow">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_padding">
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/automatic" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/automatic_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnSurface" />
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/automatic_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/automatic_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/automatic_off" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorPrimary" />
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/appearance" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/appearance" android:gravity="start|center_vertical" app:icon="@drawable/ic_palette" app:iconGravity="start" app:iconPadding="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/brightness" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/brightness" android:gravity="start|center_vertical" app:icon="@drawable/ic_brightness" app:iconGravity="start" app:iconPadding="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/connection_test" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/connection_test" android:gravity="start|center_vertical" app:icon="@drawable/ic_cable" app:iconGravity="start" app:iconPadding="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/history" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/history" android:gravity="start|center_vertical" app:icon="@drawable/ic_help" app:iconGravity="start" app:iconPadding="16dp" />
