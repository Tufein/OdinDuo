<resources>
    <style name="Theme.OdinDuo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#386A5A</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#BBEFDA</item>
        <item name="colorOnPrimaryContainer">#062018</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>
    <style name="ShapeAppearance.OdinDuo.Card" parent="ShapeAppearance.Material3.Corner.ExtraLarge" />
    <style name="TextAppearance.OdinDuo.Hero" parent="TextAppearance.Material3.HeadlineMedium" />
    <style name="Widget.OdinDuo.Card" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.OdinDuo.Card</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
